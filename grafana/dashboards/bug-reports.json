{
  "title": "AVIA AMA Bug Reports",
  "uid": "bug-reports",
  "tags": [
    "reports",
    "telemetry"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "analytics-postgres"
        },
        "query": "SELECT DISTINCT service FROM events WHERE type LIKE 'report.%' ORDER BY service;",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": "AMA_avia_project",
          "value": "AMA_avia_project"
        }
      },
      {
        "name": "report_id",
        "label": "Репорт",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "analytics-postgres"
        },
        "query": "SELECT title || ' · ' || left(report_id::text, 8) AS __text, report_id::text AS __value FROM ama_report_discussions WHERE ${service:sqlstring} = 'AMA_avia_project' ORDER BY created_at DESC, report_id;",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Открытых сейчас",
      "description": "Текущее число открытых репортов (open_total из последнего события report.*). Точное — репорты меняют статус только через API, каждое событие несёт свежий тотал.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "analytics-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT (payload->'scenario'->>'open_total')::int AS value FROM events WHERE service = '$service' AND type LIKE 'report.%' AND payload->'scenario' ? 'open_total' ORDER BY received_at DESC LIMIT 1;"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Закрытых всего",
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "analytics-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT (payload->'scenario'->>'closed_total')::int AS value FROM events WHERE service = '$service' AND type LIKE 'report.%' AND payload->'scenario' ? 'closed_total' ORDER BY received_at DESC LIMIT 1;"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Новых сегодня",
      "description": "Репортов создано с начала суток (report.created).",
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "analytics-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*)::int AS value FROM events WHERE service = '$service' AND type = 'report.created' AND received_at >= date_trunc('day', now());"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Новых за 7 дней",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "analytics-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*)::int AS value FROM events WHERE service = '$service' AND type = 'report.created' AND received_at > now() - interval '7 days';"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Закрыто за 7 дней",
      "description": "Смен статуса на closed за 7 дней.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "postgres",
        "uid": "analytics-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*)::int AS value FROM events WHERE service = '$service' AND type = 'report.status_changed' AND payload->'scenario'->>'status' = 'closed' AND received_at > now() - interval '7 days';"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Открыто / Закрыто во времени",
      "description": "Тоталы open_total и closed_total как их нёс каждый event report.*. Ступенчато между событиями.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "analytics-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "lineInterpolation": "stepAfter",
            "showPoints": "always",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "open"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "closed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT received_at AS time, (payload->'scenario'->>'open_total')::int AS \"open\", (payload->'scenario'->>'closed_total')::int AS \"closed\" FROM events WHERE service = '$service' AND type LIKE 'report.%' AND payload->'scenario' ? 'open_total' AND $__timeFilter(received_at) ORDER BY received_at;"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Новых репортов по дням",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "analytics-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', received_at) AS time, count(*)::int AS \"created\" FROM events WHERE service = '$service' AND type = 'report.created' AND $__timeFilter(received_at) GROUP BY 1 ORDER BY 1;"
        }
      ]
    },
    {
      "id": 15,
      "type": "table",
      "title": "Открытые репорты сейчас (из последнего снапшота)",
      "description": "Текущий бэклог открытых репортов — распаковка open_reports из самого свежего report.snapshot. Обновляется раз в ~10 мин. Не зависит от time picker.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "postgres",
        "uid": "analytics-postgres"
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH latest AS (SELECT payload FROM events WHERE service = '$service' AND type = 'report.snapshot' ORDER BY received_at DESC LIMIT 1) SELECT (r->>'created_at')::timestamptz AS \"Создан\", r->>'title' AS \"Заголовок\", r->>'report_id' AS \"Report ID\", r->>'owner_id' AS \"Owner ID\" FROM latest, jsonb_array_elements(payload->'scenario'->'open_reports') AS r ORDER BY (r->>'created_at')::timestamptz DESC;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Заголовок"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Посмотреть обсуждение",
                    "url": "/d/bug-reports/avia-ama-bug-reports?var-service=${service:percentencode}&var-report_id=${__data.fields[\"Report ID\"]}&viewPanel=21"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 21,
      "title": "Комментарии к репорту",
      "type": "table",
      "description": "Выберите репорт вверху или нажмите его заголовок в таблице. Файлы доступны в карточке AMA.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "postgres",
        "uid": "analytics-postgres"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Комментарий"
            },
            "properties": [
              {
                "id": "custom.wrapText",
                "value": true
              },
              {
                "id": "custom.minWidth",
                "value": 360
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Report ID"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Репорт в AMA"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Открыть обсуждение и вложения в AMA",
                    "url": "https://dashboard-digital-assistant.a-m-a.com/reports?scope=all&id=${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT c.at AS \"Время\", CASE c.role WHEN 'user' THEN 'Пользователь' WHEN 'admin' THEN 'Команда разработки' WHEN 'dev' THEN 'Разработчик' WHEN 'support' THEN 'Поддержка' ELSE c.role END AS \"Автор\", CASE WHEN c.id IS NULL THEN 'Комментариев пока нет' ELSE c.message END AS \"Комментарий\", c.attachments AS \"Файлов\", r.report_id::text AS \"Report ID\" FROM ama_report_discussions r LEFT JOIN LATERAL jsonb_to_recordset(r.comments) AS c(id uuid, at timestamptz, role text, message text, attachments int) ON true WHERE ${service:sqlstring} = 'AMA_avia_project' AND r.report_id::text = ANY(ARRAY[${report_id:sqlstring}]::text[]) ORDER BY c.at, c.id;"
        }
      ]
    },
    {
      "id": 20,
      "type": "table",
      "title": "Лента событий репортов (новые сверху)",
      "description": "События создания / смены статуса / удаления репортов (снапшоты сюда не попадают). 'Новый репорт пришёл' = строка с типом 🆕 создан.",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 16
      },
      "datasource": {
        "type": "postgres",
        "uid": "analytics-postgres"
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Событие"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "report.created": {
                        "text": "🆕 создан",
                        "color": "blue",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "report.status_changed": {
                        "text": "🔁 статус",
                        "color": "orange",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "report.deleted": {
                        "text": "🗑 удалён",
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Заголовок"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Посмотреть обсуждение",
                    "url": "/d/bug-reports/avia-ama-bug-reports?var-service=${service:percentencode}&var-report_id=${__data.fields[\"Report ID\"]}&viewPanel=21"
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT received_at AS \"Время\", type AS \"Событие\", payload->'scenario'->>'title' AS \"Заголовок\", payload->'scenario'->>'status' AS \"Статус\", (payload->'scenario'->>'open_total')::int AS \"Открыто\", (payload->'scenario'->>'closed_total')::int AS \"Закрыто\", payload->'scenario'->>'report_id' AS \"Report ID\" FROM events WHERE service = '$service' AND type IN ('report.created', 'report.status_changed', 'report.deleted') AND $__timeFilter(received_at) ORDER BY received_at DESC LIMIT 200;"
        }
      ]
    }
  ]
}
