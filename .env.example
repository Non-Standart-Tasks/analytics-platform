# --- Домен (один на всё; разделение через пути) ---
# /            → Grafana
# /api/v1/...  → приёмник телеметрии
ANALYTICS_DOMAIN=analytics-platform.example.com

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=analytics
POSTGRES_USER=analytics
POSTGRES_PASSWORD=changeme-postgres-password

# --- Receiver ---
# Секрет для подписи JWT, который шлют клиенты telemetry-client.
# Сгенерировать: openssl rand -hex 64
TELEMETRY_JWT_SECRET=changeme-jwt-secret-64-hex-chars

# Алгоритм JWT (HS256 — общий секрет, подойдёт для начала)
TELEMETRY_JWT_ALGORITHM=HS256

# Размер очереди ingest-воркера; при переполнении возвращаем 503
INGEST_QUEUE_SIZE=10000

# --- Traefik / Let's Encrypt ---
LETSENCRYPT_EMAIL=ops@example.com

# --- Grafana ---
# Учётка админа создаётся при первом старте контейнера.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-grafana-admin-password
